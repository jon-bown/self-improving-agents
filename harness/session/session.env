# selfimprove settings for the ODSC session: OpenClaw, traced by the MLflow connector.
# Use it with SI_ENV_FILE=session/session.env (the notebooks, RUNBOOK.md and precompute.py do).
# Relative paths resolve against this folder. Keys come from harness/.env or the environment.

# MLflow: the session store, served over HTTP so the OpenClaw plugin can export to it.
# `make session-server` starts it on this port.
MLFLOW_TRACKING_URI=http://127.0.0.1:19560
SI_EXPERIMENT=acme-openclaw

# The agent: OpenClaw, with each instructions version rendered as its AGENTS.md next to knowledge/
SI_AGENT=openclaw
SI_AGENT_MODEL=anthropic:/claude-haiku-5-5
SI_AGENT_TIMEOUT=600
SI_OPENCLAW_MLFLOW=1
SI_AGENT_NAME=acme_support
SI_INPUT_KEY=question

# What the loop improves
SI_PROMPT_NAME=acme-agents-md
SI_INSTRUCTIONS_FILE=agent/AGENTS.md
SI_WORKSPACE_DIR=knowledge
SI_GOLDEN_FILE=golden.yaml
# The verifier grows one loop at a time: criteria/loop1.yaml ... loop4.yaml (each adds to the last)
SI_CRITERIA_FILE=criteria/loop1.yaml

# Models
SI_JUDGE_MODEL=anthropic:/claude-sonnet-5-5
SI_IMPROVER=analyst

# Local state: checkpoints, the human queue, workspaces, the isolated OpenClaw profile
SI_STATE_DIR=.state

# Guardrails: tuned for 8 questions per loop
SI_TRIAGE_THRESHOLD=3
SI_TESTS_PER_THEME_CAP=4
SI_HOLDOUT_FRACTION=0.2
SI_MIN_TRACES=6
SI_FAIL_THRESHOLD=0.15
SI_MIN_ALIGNMENT_TRACES=10
# Loop 3: a person raised this from the default 2.0 after the gate rejected MetaPrompt's v7 on
# length alone (2.2x). The growth was a new security section on a short (1.8k-character) prompt.
SI_MAX_PROMPT_GROWTH=2.5
SI_AUTO_PROMOTE=false
