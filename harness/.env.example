# selfimprove harness configuration. Copy to .env and fill in.
#
# You must set: an API key for your models (section 4) and how to call your agent (section 2).
# Everything else has a working default. Relative paths resolve against this file's folder.
#
#   1. MLflow                 5. Verifier
#   2. Your agent             6. Update step
#   3. What the loop improves 7. Guardrails
#   4. Models                 8. Advanced

# =============================================================================================
# 1. MLflow
# =============================================================================================
# A local SQLite store keeps the harness away from any server you already run. Point this at a
# shared server (e.g. http://127.0.0.1:5000) when CI or several people need the same history.
MLFLOW_TRACKING_URI=sqlite:///.selfimprove/mlflow.db
SI_EXPERIMENT=my-agent

# =============================================================================================
# 2. Your agent: how the harness calls it
# =============================================================================================
# The harness keeps your agent's instructions (system prompt, AGENTS.md, SKILL.md, ...) in the
# MLflow Prompt Registry and passes the chosen version to your agent on every call. Pick one:
#
#   python   a function `def answer(question: str, instructions: str) -> str`
#   http     POST {"input": ..., "instructions": ...} to SI_AGENT_URL, read "output" back
#   command  any CLI; {input}, {instructions_file} and {workspace} are filled in
#   litellm  no code: a tool-free chat agent on SI_AGENT_MODEL with the instructions as system prompt
#   openclaw OpenClaw (`openclaw agent --local`) with the instructions rendered as AGENTS.md
SI_AGENT=python
# SI_AGENT_TIMEOUT=600                                # seconds per call, any backend

# --- python ---
SI_AGENT_TARGET=examples.support_agent:answer

# --- http ---
# SI_AGENT_URL=http://127.0.0.1:8000/answer
# SI_AGENT_TOKEN=                                     # sent as "Authorization: Bearer <token>"

# --- command ---
# SI_AGENT_COMMAND=my-agent --system-file {instructions_file} --message {input}

# --- litellm / openclaw / the example agent ---
# SI_AGENT_MODEL=anthropic:/claude-haiku-5-5

# --- openclaw ---
# OPENCLAW_BIN=openclaw
# Install the MLflow tracing plugin (connectors/openclaw-mlflow) into the isolated profile on
# `selfimprove doctor`, for OpenClaw's own LLM/tool spans. Needs an HTTP MLFLOW_TRACKING_URI
# (an `mlflow server`), not the SQLite default.
# SI_OPENCLAW_MLFLOW=1

# --- Tracing ---
# Name of the root span of every agent trace, and the key the question is passed under.
SI_AGENT_NAME=my_agent
SI_INPUT_KEY=question
# Already tracing your agent yourself? Point the harness at those traces instead of (or as well
# as) the ones it creates. Any MLflow trace filter.
# SI_PRODUCTION_FILTER=tags.environment = 'production'

# =============================================================================================
# 3. What the loop improves
# =============================================================================================
# The file is registered as version 1 by `selfimprove init`.
SI_PROMPT_NAME=my-agent-instructions
SI_INSTRUCTIONS_FILE=examples/instructions.md
# Files rendered next to the instructions (as {workspace}) for file-based agents such as
# OpenClaw. They stay fixed; only the instructions change.
SI_WORKSPACE_DIR=examples/knowledge

# =============================================================================================
# 4. Models (MLflow URI format "<provider>:/<model>"; keys come from the provider's usual variable)
# =============================================================================================
# --- API keys ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# TYPESAFE_API_KEY=                                   # only for the Jev fast judge below

# --- Judge ---
# The judge also runs the trace analyst, the reviewer agent and the optimizers' reflection step.
SI_JUDGE_MODEL=anthropic:/claude-opus-5-5

# --- Fast first-pass judge (optional; Part 3, section 3) ---
# Jev returns a yes/no with a probability instead of generated text, cheap enough to judge most
# production traffic. Verdicts whose pass probability falls inside SI_FAST_JUDGE_BAND go to
# SI_JUDGE_MODEL, which adds the rationale Jev lacks. Choose the band from your own labeled
# data: `selfimprove align` reports where Jev's disagreements with people fall.
# SI_FAST_JUDGE_MODEL=typesafe:/jev-latest
# SI_FAST_JUDGE_BAND=0.5,0.8

# --- Embeddings (optional) ---
# MemAlign judge alignment needs an embedding model; without one SIMBA is used.
# SI_EMBEDDING_MODEL=openai:/text-embedding-3-small

# =============================================================================================
# 5. Verifier: what "good" means
# =============================================================================================
# Code checks, Guidelines judges, the alignable "quality" judge, and must-pass scorers.
SI_CRITERIA_FILE=examples/criteria.yaml
# Hand-written golden cases (inputs + expectations). Merged into the dataset by `init`.
SI_GOLDEN_FILE=examples/golden.yaml

# =============================================================================================
# 6. Update step: who writes the candidate (Part 3 of the blog series)
# =============================================================================================
# analyst | gepa | metaprompt | command
SI_IMPROVER=analyst
# For SI_IMPROVER=command: a coding agent that edits {instructions_file} in {workspace} using
# {workspace}/failure_report.json. Examples:
#   claude -p "$(cat {workspace}/TASK.md)" --allowedTools Read,Edit --add-dir {workspace}
#   openclaw agent exec "$(cat {workspace}/TASK.md)" --cwd {workspace} --isolated --json
# SI_IMPROVER_COMMAND=

# =============================================================================================
# 7. Guardrails
# =============================================================================================
# --- When the loop acts ---
SI_FAIL_THRESHOLD=0.15         # the loop only proposes a change above this live failure rate
SI_MIN_TRACES=8                # ...and only with at least this many judged traces
SI_TRIAGE_THRESHOLD=5          # new labeled failures before triage runs

# --- Dataset ---
SI_TESTS_PER_THEME_CAP=3       # one bug, forty complaints -> at most this many tests
SI_HOLDOUT_FRACTION=0.2        # dataset rows hidden from every automated step

# --- Judge alignment ---
SI_AGREEMENT_THRESHOLD=0.75    # judge-vs-human agreement below this triggers alignment
SI_MIN_ALIGNMENT_TRACES=10     # MLflow recommends >= 10 labeled traces, >= 30% per class

# --- Promotion gate ---
SI_PROMOTION_MARGIN=0.0        # candidate must beat production on the holdout by at least this
SI_MAX_PROMPT_GROWTH=2.0       # reject candidates more than this many times longer
SI_AUTO_PROMOTE=false          # true: the gate moves the alias itself. false: a person does.

# --- After promotion ---
SI_ROLLBACK_MARGIN=0.10        # roll back when live failure rate rises this much after a promotion

# =============================================================================================
# 8. Advanced (defaults shown)
# =============================================================================================
# SI_DATASET_NAME=my-agent-regressions                # default: <SI_EXPERIMENT>-regressions
# SI_STATE_DIR=.selfimprove                           # checkpoints, human queue, improver workspaces
# SI_REVIEWER=                                        # name on human labels; default: OS username
# SI_NO_LLM=1                                         # code checks only, no judge calls
