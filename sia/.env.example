# Copy to .env and fill in.

# ---- Pick a provider -----------------------------------------------------------------------
# anthropic | openai | gemini | mistral | groq | ollama
# Each preset picks a small "agent" model and a stronger "judge" model (see src/sia/llm.py).
SIA_PROVIDER=anthropic

# ...and set that provider's key (Ollama needs none; it must be running locally).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# ---- Optional: choose models yourself (MLflow URI format "<provider>:/<model>") ------------
# Providers can be mixed, e.g. a cheap local agent graded by a hosted judge:
# SIA_AGENT_MODEL=ollama:/gpt-oss:20b
# MLFLOW_GENAI_JUDGE_DEFAULT_MODEL=openai:/gpt-5.5
# MemAlign judge alignment needs embeddings; filled in automatically for openai/gemini/mistral.
# SIA_EMBEDDING_MODEL=openai:/text-embedding-3-small

# ---- Everything else has sensible defaults --------------------------------------------------
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
SIA_EXPERIMENT=acme-support-agent
# Runtime for the support agent: openclaw | direct | offline
SIA_BACKEND=openclaw
