# Copy to .env and fill in.

# ---- Pick a provider -----------------------------------------------------------------------
# anthropic (default: Claude) | ollama (local, no key) | openai | gemini | mistral | groq
# Each preset picks an "agent" model and a "judge" model (see src/sia/llm.py).
SIA_PROVIDER=anthropic

# Claude: Haiku 5.5 answers as the support agent; Opus 5.5 judges, analyzes, and optimizes.
ANTHROPIC_API_KEY=

# Ollama (SIA_PROVIDER=ollama): start the server and pull the model (`make ollama`).
# OLLAMA_API_BASE=http://localhost:11434
# SIA_OLLAMA_NUM_CTX=32768          # context window requested from Ollama

# Other hosted providers: set the key for the one you pick.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# ---- Optional: choose models yourself (MLflow URI format "<provider>:/<model>") ------------
# Providers can be mixed, e.g. a cheap local agent graded by a hosted judge:
# SIA_AGENT_MODEL=anthropic:/claude-sonnet-5-5         # a stronger agent (fewer seeded failures)
# MLFLOW_GENAI_JUDGE_DEFAULT_MODEL=anthropic:/claude-opus-5-5
# SIA_AGENT_EFFORT=low                                   # Claude effort for agent answers
# MemAlign judge alignment needs embeddings; filled in automatically for openai/gemini/mistral.
# SIA_EMBEDDING_MODEL=openai:/text-embedding-3-small

# ---- Everything else has sensible defaults --------------------------------------------------
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
SIA_EXPERIMENT=acme-support-agent
# Runtime for the support agent: openclaw | direct | offline
SIA_BACKEND=openclaw
